<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Pigeon Escape - Global Elite</title>
    <style>
        :root { --primary: #3498db; --danger: #e74c3c; --success: #2ecc71; --dark: #2c3e50; --gold: #f1c40f; }
        body { margin: 0; background: #1a1a1a; font-family: 'Segoe UI', sans-serif; color: white; display: flex; flex-direction: column; align-items: center; overflow: hidden; touch-action: manipulation; }
        #game-container { position: relative; width: 100vw; height: 100vh; max-width: 800px; max-height: 600px; background: #333; margin-top: 20px; box-shadow: 0 0 50px rgba(0,0,0,0.5); border-radius: 8px; overflow: hidden; }
        canvas { width: 100%; height: 100%; display: block; }
        .ui-overlay { position: absolute; inset: 0; display: flex; flex-direction: column; justify-content: center; align-items: center; background: rgba(0,0,0,0.85); z-index: 10; text-align: center; }
        .hidden { display: none !important; }
        button { padding: 15px 40px; font-size: 1.1rem; text-transform: uppercase; font-weight: bold; cursor: pointer; border: none; border-radius: 50px; margin: 10px; transition: 0.2s; }
        #btn-takeoff { position: absolute; bottom: 40px; left: 50%; transform: translateX(-50%); background: var(--success); color: white; width: 220px; z-index: 5; box-shadow: 0 4px 15px rgba(0,0,0,0.3); }
        .menu-btn { background: var(--primary); color: white; }
        .restart-btn { background: var(--danger); color: white; }
        #hud { position: absolute; top: 20px; left: 20px; z-index: 5; pointer-events: none; text-shadow: 2px 2px 4px black; }
        .stat-val { font-weight: bold; color: var(--primary); }
        
        /* Leaderboard Styles */
        #leaderboard { margin-top: 20px; width: 300px; background: rgba(255,255,255,0.1); border-radius: 10px; padding: 15px; }
        .leader-entry { display: flex; justify-content: space-between; padding: 5px 0; border-bottom: 1px solid rgba(255,255,255,0.05); }
        .is-user { color: var(--gold); font-weight: bold; }
    </style>
</head>
<body>

<div id="game-container">
    <canvas id="gameCanvas"></canvas>
    <div id="hud">
        <div id="location-display">Marseille, France</div>
        <div>Niveau: <span id="level-display" class="stat-val">1</span></div>
        <div>Record: <span id="highscore-display" class="stat-val">0</span></div>
    </div>

    <div id="ui-menu" class="ui-overlay">
        <h1 style="font-size: 3rem; margin-bottom: 0;">PIGEON ESCAPE</h1>
        <p style="color: #bdc3c7;">CLASSEMENT MONDIAL DES SURVIVANTS</p>
        
        <div id="leaderboard">
            </div>

        <button class="menu-btn" onclick="startGame('PLAY')">Jouer maintenant</button>
    </div>

    <div id="ui-gameover" class="ui-overlay hidden">
        <h1 style="color:var(--danger); font-size: 3.5rem;">CRASH !</h1>
        <p id="death-msg"></p>
        <button class="restart-btn" onclick="resetToMenu()">Retour au Menu</button>
    </div>

    <div id="ui-win" class="ui-overlay hidden">
        <h1 style="color:var(--success)">NIVEAU RÉUSSI</h1>
        <button class="menu-btn" onclick="nextLevel()">Niveau Suivant</button>
    </div>

    <button id="btn-takeoff" class="hidden" onmousedown="handleTakeOff()" ontouchstart="handleTakeOff()">DÉCOLLER !</button>
</div>

<script>
/**
 * AUDIO ENGINE
 */
const audioCtx = new (window.AudioContext || window.webkitAudioContext)();
function playSound(type) {
    if(audioCtx.state === 'suspended') audioCtx.resume();
    const osc = audioCtx.createOscillator();
    const gain = audioCtx.createGain();
    osc.connect(gain); gain.connect(audioCtx.destination);

    if (type === 'jump') {
        osc.frequency.setValueAtTime(200, audioCtx.currentTime);
        osc.frequency.exponentialRampToValueAtTime(800, audioCtx.currentTime + 0.1);
        gain.gain.setValueAtTime(0.1, audioCtx.currentTime);
        osc.start(); osc.stop(audioCtx.currentTime + 0.1);
    } else if (type === 'crash') {
        osc.type = 'sawtooth';
        osc.frequency.setValueAtTime(100, audioCtx.currentTime);
        osc.frequency.linearRampToValueAtTime(20, audioCtx.currentTime + 0.4);
        gain.gain.setValueAtTime(0.3, audioCtx.currentTime);
        gain.gain.linearRampToValueAtTime(0.01, audioCtx.currentTime + 0.4);
        osc.start(); osc.stop(audioCtx.currentTime + 0.4);
    }
}

/**
 * GAME CORE
 */
const canvas = document.getElementById('gameCanvas');
const ctx = canvas.getContext('2d');
const btnTakeOff = document.getElementById('btn-takeoff');

let currentLevelIdx = 0;
let highScore = parseInt(localStorage.getItem('pigeonHighScore')) || 0;
let gameActive = false;
let particles = [];

const pigeon = { x: 150, y: 450, baseY: 450, isFlying: false, velocity: 0 };
const car = { x: 900, y: 430, width: 130, height: 60, speed: 0 };

const LEVELS = Array.from({length: 50}, (_, i) => ({
    id: i + 1,
    city: ["Marseille", "Tokyo", "Berlin", "Paris", "NYC"][i % 5],
    speed: 6.5 + (i * 0.45),
    night: i % 3 === 0
}));

// Mock Leaderboard Data
const FAKE_PLAYERS = [
    { name: "PigeonMaster", score: 48 },
    { name: "Birdy99", score: 35 },
    { name: "SkyDancer", score: 22 },
    { name: "TurboWing", score: 14 },
    { name: "Vous", score: 0 }
];

function updateLeaderboardUI() {
    const lb = document.getElementById('leaderboard');
    lb.innerHTML = '<h3>Classement Mondial</h3>';
    
    // Update user score in fake data
    const userEntry = FAKE_PLAYERS.find(p => p.name === "Vous");
    userEntry.score = highScore;
    
    const sorted = [...FAKE_PLAYERS].sort((a,b) => b.score - a.score);
    
    sorted.forEach((p, i) => {
        const div = document.createElement('div');
        div.className = `leader-entry ${p.name === "Vous" ? 'is-user' : ''}`;
        div.innerHTML = `<span>${i+1}. ${p.name}</span> <span>Niv. ${p.score}</span>`;
        lb.appendChild(div);
    });
}

function init() {
    document.getElementById('highscore-display').innerText = highScore;
    updateLeaderboardUI();
    resize();
    updateLoop();
}

function resize() { canvas.width = 800; canvas.height = 600; }

function startGame() {
    hideAllUI();
    currentLevelIdx = 0;
    setupLevel(0);
    btnTakeOff.classList.remove('hidden');
    gameActive = true;
}

function setupLevel(idx) {
    const lvl = LEVELS[idx];
    document.getElementById('level-display').innerText = lvl.id;
    document.getElementById('location-display').innerText = lvl.city;
    pigeon.isFlying = false; pigeon.y = pigeon.baseY; pigeon.velocity = 0;
    car.x = 900; car.speed = lvl.speed;
}

function handleTakeOff() {
    if (!gameActive || pigeon.isFlying) return;
    pigeon.isFlying = true; pigeon.velocity = -9.5;
    playSound('jump');
    for(let i=0; i<5; i++) createParticle(pigeon.x, pigeon.y, '#fff');
}

function createParticle(x, y, color) {
    particles.push({ x, y, vx: (Math.random()-0.5)*8, vy: (Math.random()-0.5)*8, life: 1, color });
}

function updateLoop() {
    ctx.clearRect(0,0,800,600);
    const lvl = LEVELS[currentLevelIdx];
    
    // Draw Background
    ctx.fillStyle = lvl.night ? "#2c3e50" : "#87CEEB";
    ctx.fillRect(0,0,800,600);
    ctx.fillStyle = "#333"; ctx.fillRect(0,480,800,120);

    if (gameActive) {
        car.x -= car.speed;
        if(pigeon.isFlying) { pigeon.y += pigeon.velocity; pigeon.velocity += 0.38; }

        // Collision
        if (car.x < pigeon.x + 25 && car.x + 130 > pigeon.x - 25 && pigeon.y > 415) {
            triggerGameOver();
        } else if (car.x + 130 < 0) {
            if(!pigeon.isFlying) triggerGameOver(); else triggerWin();
        }
    }

    // Particles
    particles.forEach((p, i) => {
        p.x += p.vx; p.y += p.vy; p.life -= 0.03;
        ctx.fillStyle = `rgba(255,255,255,${p.life})`;
        ctx.fillRect(p.x, p.y, 4, 4);
        if(p.life <= 0) particles.splice(i, 1);
    });

    // Draw Pigeon
    ctx.fillStyle = "#bdc3c7";
    ctx.beginPath(); ctx.ellipse(pigeon.x, pigeon.y, 20, 15, 0, 0, Math.PI*2); ctx.fill();
    ctx.fillStyle = "#7f8c8d";
    ctx.beginPath(); ctx.arc(pigeon.x+15, pigeon.y-10, 10, 0, Math.PI*2); ctx.fill();

    // Draw Car
    ctx.fillStyle = "#e74c3c";
    ctx.fillRect(car.x, car.y, 130, 60);
    ctx.fillStyle = "#222";
    ctx.beginPath(); ctx.arc(car.x+30, 490, 15, 0, Math.PI*2); ctx.arc(car.x+100, 490, 15, 0, Math.PI*2); ctx.fill();

    requestAnimationFrame(updateLoop);
}

function triggerGameOver() {
    gameActive = false;
    playSound('crash');
    for(let i=0; i<20; i++) createParticle(pigeon.x, pigeon.y, '#e74c3c');
    document.getElementById('ui-gameover').classList.remove('hidden');
    document.getElementById('death-msg').innerText = "Aucun pigeon n'a été épargné cette fois.";
    btnTakeOff.classList.add('hidden');
}

function triggerWin() {
    gameActive = false;
    if(currentLevelIdx + 1 > highScore) {
        highScore = currentLevelIdx + 1;
        localStorage.setItem('pigeonHighScore', highScore);
        document.getElementById('highscore-display').innerText = highScore;
    }
    document.getElementById('ui-win').classList.remove('hidden');
    btnTakeOff.classList.add('hidden');
}

function nextLevel() {
    currentLevelIdx++;
    setupLevel(currentLevelIdx);
    hideAllUI();
    btnTakeOff.classList.remove('hidden');
    gameActive = true;
}

function resetToMenu() {
    hideAllUI();
    updateLeaderboardUI();
    document.getElementById('ui-menu').classList.remove('hidden');
    gameActive = false;
}

function hideAllUI() {
    ['ui-menu', 'ui-gameover', 'ui-win'].forEach(id => document.getElementById(id).classList.add('hidden'));
}

init();
</script>
</body>
</html>
